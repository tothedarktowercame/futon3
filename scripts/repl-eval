#!/usr/bin/env bash
# Compatibility name only. The cookie/query-token client formerly implemented
# here targeted futon3's retired :6767 serving path. The one live serving JVM
# is futon3c on :6768 and authenticates with x-admin-token.

set -euo pipefail

FUTON3C_ROOT="${FUTON3C_ROOT:-/home/joe/code/futon3c}"
EVAL="${FUTON3C_ROOT}/scripts/proof-eval.sh"

if [[ ! -x "$EVAL" ]]; then
  echo "repl-eval: canonical evaluator not found: $EVAL" >&2
  exit 1
fi

if [[ -z "${FUTON3C_ADMIN_TOKEN:-}" && -z "${ADMIN_TOKEN:-}" ]]; then
  TOKEN_FILE="${FUTON3C_ROOT}/.admintoken"
  if [[ ! -r "$TOKEN_FILE" ]]; then
    echo "repl-eval: canonical token not readable: $TOKEN_FILE" >&2
    exit 1
  fi
  export FUTON3C_ADMIN_TOKEN
  FUTON3C_ADMIN_TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"
fi

echo "repl-eval: compatibility wrapper; canonical command is $EVAL" >&2
exec "$EVAL" "$@"
